  ],
  "build_command": ["bash", "build.sh", "--soc=ascend950", "--ops=swiglu", "--install"],
  "test_command": ["python3", "tests/test_swiglu_official.py"],
  "bench_command": null,
  "profile_command": ["python3", "tests/profile_swiglu.py"],
  "timeout_s": 900,
  "soc": "ascend950",
